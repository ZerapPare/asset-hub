# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local)
# ค่าลับตอน deploy ไม่อยู่ที่นี่ — ใช้ npx sst secret set (infra/secrets.ts)

# Postgres ในเครื่อง (docker-compose)
DATABASE_URL=postgres://postgres:dev@localhost:5432/assethub
# จำนวน connection ต่อ process (Lambda = 1 ตาม ADR-3)
DATABASE_POOL_MAX=1

# S3: MinIO ในเครื่อง (docker-compose — user/password ตรงกับ MINIO_ROOT_*, console http://localhost:9001)
# ใช้ S3 จริงแทน: comment 3 บรรทัด S3_ENDPOINT / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
#   แล้วตั้ง S3_BUCKET เป็นชื่อใน infra/storage.ts (ใช้ credentials จาก AWS CLI profile; CORS ของ bucket ต้องมี http://localhost:3000)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=fanparetar
S3_BUCKET=assethub-dev
AWS_REGION=ap-southeast-1
# Bedrock (Titan ไม่มีใน ap-southeast-1): ap-south-1 (Mumbai) หรือ ap-southeast-2 (Sydney)
# dev ในเครื่องใช้ credentials จาก AWS CLI profile (~/.aws)
BEDROCK_REGION=ap-south-1

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=kmitl.ac.th
# สุ่มยาวๆ เช่น openssl rand -base64 48
JWT_SECRET=

# ไม่ต้องตั้งในเครื่อง — SST ใส่ให้ตอน deploy
# PROCESSING_QUEUE_URL=   ไม่ตั้ง = ประมวลผลใน server (dev) / ตั้ง = ส่งเข้า SQS (infra/processing.ts)
# ALARM_EMAIL=            ตั้งใน shell ตอน sst deploy → อีเมลแจ้งเตือนเมื่อมีไฟล์ตกไป DLQ
