# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local)

# Postgres ในเครื่อง (docker-compose: postgres://postgres:dev@localhost:5432/assethub)
DATABASE_URL=postgres://postgres:<password>@localhost:5432/assethub
# จำนวน connection ต่อ process (Lambda = 1 ตาม ADR-3)
DATABASE_POOL_MAX=1

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=assethub-dev
AWS_REGION=ap-southeast-1
MAX_FILE_SIZE=20971520

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=kmitl.ac.th
JWT_SECRET=
